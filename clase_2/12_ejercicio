edad = int(input("Edad: "))
mensaje = ""
if edad < 0:
    mensaje = "[!] Edad no válida."
elif edad < 13:
    mensaje = "Eres niño."
elif edad < 18:
    mensaje = "Eres adolescente."
elif edad < 65:
    mensaje = "Eres adulto."
elif edad < 120:
    mensaje = "Eres adulto mayor."
else:
    mensaje = "¿Estás vivo?"
print(mensaje)
